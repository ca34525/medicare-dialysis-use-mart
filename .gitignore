# Python bytecode, environments, and packaging artifacts
__pycache__/
*.py[cod]
*$py.class
.python-version.local
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/
.eggs/

# Python tooling and test output
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
.test-artifacts/
.ipynb_checkpoints/

# Local data, downloads, and generated publications
/data/*
!/data/.gitkeep
!/data/README.md
/raw/
/downloads/
/outputs/
/artifacts/
*.duckdb
*.duckdb.wal
*.duckdb.tmp
*.db
*.sqlite
*.sqlite3
*.parquet

# Representative deterministic fixtures remain version controlled.
!tests/fixtures/**/*.duckdb
!tests/fixtures/**/*.db
!tests/fixtures/**/*.sqlite
!tests/fixtures/**/*.sqlite3
!tests/fixtures/**/*.parquet

# dbt generated state and local profiles
**/target/
**/dbt_packages/
**/logs/
.dbt/
profiles.yml
!profiles.example.yml

# Airflow local runtime state
.airflow/
airflow.db
airflow.db-*
airflow.cfg
standalone_admin_password.txt
/orchestration/logs/
/orchestration/airflow.db*

# Local environment files, credentials, and keys
.env
.env.*
!.env.example
.envrc
.secrets/
secrets/
credentials.json
*_credentials.json
service-account*.json
*.pem
*.key
*.p12
*.pfx

# Terraform local state and potentially sensitive variable values
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.json.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Power BI local caches, locks, and recovery files (deliverables stay tracked)
~$*.pbix
~$*.pbit
*.pbix.tmp
*.pbit.tmp
*.pbix.autorecover
**/.pbi/localSettings.json
**/.pbi/cache.abf
**/.pbi/desktopState.json

# Editors and operating systems
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*~
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
