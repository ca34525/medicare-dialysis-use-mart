# Copy this file to .env for local overrides. Never commit the resulting .env.
# Values here are non-secret development defaults; replace the contact address.

KCAM_ENV=development
KCAM_LOG_LEVEL=INFO

# Generated data remains beneath this ignored root.
KCAM_DATA_DIR=./data
KCAM_DUCKDB_PATH=./data/warehouse/kidney_care_mart.duckdb
KCAM_PUBLISH_DIR=./data/published

# Public-source HTTP behavior.
KCAM_HTTP_TIMEOUT_SECONDS=30
KCAM_HTTP_MAX_RETRIES=3
KCAM_HTTP_USER_AGENT=KidneyCareAnalyticsMart/0.1 (contact: replace-me@example.com)
