root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,mdx}]
# Preserve intentional Markdown hard line breaks.
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

[*.{toml,sql,py,pyi,ps1,sh,tf}]
indent_size = 4

[Makefile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf

